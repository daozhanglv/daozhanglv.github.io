{{- $pages := .Pages -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "posts" -}}
{{- else -}}
  {{- $pages = where $pages "Section" "posts" -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if .IsHome }}{{ site.Params.author }} · {{ site.Title }}{{ else }}{{ .Title }} · {{ site.Params.author }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.Locale | default "en" }}</language>
    {{- with site.Params.email }}
    <managingEditor>{{ . }} ({{ site.Params.author }})</managingEditor>
    <webMaster>{{ . }} ({{ site.Params.author }})</webMaster>
    {{- end }}
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with site.Params.email }}<author>{{ . }} ({{ site.Params.author }})</author>{{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ (.Description | default (.Summary | plainify)) | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
